
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- SCROLLABLE PROFILE CONTENT -->
    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Account"
                android:textColor="#167A43"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"/>

            <!-- PROFILE INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="#F2F8F3">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="42sp"
                    android:background="#DDEBDD"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Juan Dela Cruz"
                        android:textColor="#202020"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Juan.dela.cruz@gmail.com"
                        android:textColor="#777777"
                        android:textSize="13sp"
                        android:layout_marginTop="5dp"/>

                </LinearLayout>
            </LinearLayout>

            <!-- ACCOUNT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT SETTINGS"
                android:textColor="#168447"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <!-- PERSONAL INFORMATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="♙   Personal Information                  ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"/>

            <!-- SAVED ADDRESSES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="⌖   Saved Addresses                       ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"
                android:layout_marginTop="8dp"/>

            <!-- ORDER HISTORY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="▤   Order History                            ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"
                android:layout_marginTop="8dp"/>

            <!-- PREFERENCES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFERENCES"
                android:textColor="#168447"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <!-- SETTINGS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="⚙   Settings                                     ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"/>

            <!-- HELP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="?   Help &amp; Support                        ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"
                android:layout_marginTop="8dp"/>

            <!-- ABOUT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="ⓘ   About the App                            ›"
                android:textColor="#333333"
                android:textSize="15sp"
                android:background="#F6F8F6"
                android:layout_marginTop="8dp"/>

            <!-- LOGOUT -->
            <Button
                android:id="@+id/button21"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#5EBC12"
                android:text="LOG OUT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

    <!-- FIXED BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/button27"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂&#10;Dashboard"
            android:textSize="10sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#168447"/>

        <Button
            android:id="@+id/button26"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌕&#10;Explore"
            android:textSize="10sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#168447"/>

        <Button
            android:id="@+id/button25"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▤&#10;Reservations"
            android:textSize="10sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#168447"/>

        <Button
            android:id="@+id/button24"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♡&#10;Favorites"
            android:textSize="10sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#168447"/>

        <Button
            android:id="@+id/button23"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♙&#10;Profile"
            android:textSize="10sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#168447"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
