        android:textColor="#396A25"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="345dp" />

    <Button
        android:id="@+id/button3"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:text="Enter your Password"
        android:textColor="#396A25"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="423dp" />

    <Button
        android:id="@+id/button12"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:text="Login with Google"
        android:textColor="#396A25"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="607dp" />

    <Button
        android:id="@+id/button4"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:background="#396A25"
        android:text="Login"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="515dp" />

    <Button
        android:id="@+id/button9"
        android:layout_width="97dp"
        android:layout_height="56dp"
        android:foreground="@drawable/app_logo_app_name__text__tagline__text__welcome_message__text__email_label__text__email_input_field_email_icon_password_label__text__password_input_field_showhide_password_icon_forgot_password__te"
        android:text="Button"
        tools:layout_editor_absoluteX="157dp"
        tools:layout_editor_absoluteY="93dp" />

