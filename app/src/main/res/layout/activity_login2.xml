<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundTint="#2C9731"
    tools:context="ReserveBites.Login">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login to continue to your account."
        android:textColor="#396A25"
        android:textSize="12sp"
        android:textStyle="normal"
        tools:layout_editor_absoluteX="113dp"
        tools:layout_editor_absoluteY="287dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="572dp"
        android:layout_height="416dp"
        app:srcCompat="@mipmap/ic_launcher_foreground"
        tools:layout_editor_absoluteX="-80dp"
        tools:layout_editor_absoluteY="-185dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="572dp"
        android:layout_height="416dp"
        app:srcCompat="@mipmap/ic_launcher_foreground"
        tools:layout_editor_absoluteX="-80dp"
        tools:layout_editor_absoluteY="504dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="205dp"
        android:layout_height="46dp"
        android:text="ReserveBites"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textColor="#396A25"
        android:textSize="34sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="107dp"
        tools:layout_editor_absoluteY="166dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book. Dine. Enjoy."
        android:textColor="#396A25"
        android:textSize="12sp"
        android:textStyle="normal"
        tools:layout_editor_absoluteX="156dp"
        tools:layout_editor_absoluteY="212dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back!"
        android:textColor="#396A25"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="151dp"
        tools:layout_editor_absoluteY="265dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="#396A25"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="331dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:textColor="#396A25"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="246dp"
        tools:layout_editor_absoluteY="477dp" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="or"
        android:textColor="#396A25"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="590dp" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="#396A25"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="409dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:text="Enter Your Email"
        android:textColor="#396A25"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="345dp" />

    <Button
        android:id="@+id/button3"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:text="Enter your Password"
        android:textColor="#396A25"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="423dp" />

    <Button
        android:id="@+id/button4"
        android:layout_width="243dp"
        android:layout_height="47dp"
        android:background="#396A25"
        android:text="Login"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textDirection="firstStrongRtl"
        android:textIsSelectable="true"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="515dp" />

</androidx.constraintlayout.widget.ConstraintLayout>