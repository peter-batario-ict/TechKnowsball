        android:textColor="#396A25"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="331dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
