<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="ReserveBites.Dashboard">

  <!-- TRIPLE BAR MENU -->

  <!-- WELCOME MESSAGE -->

  <ImageView
      android:id="@+id/tripleBarIcon"
      android:layout_width="26dp"
      android:layout_height="17dp"
      android:layout_marginTop="28dp"
      android:layout_marginEnd="368dp"
      android:contentDescription="Menu"
      android:scaleType="fitCenter"
      android:src="@drawable/triplebar"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/textView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="70dp"
      android:fontFamily="sans-serif-black"
      android:text="Hi, Juan Dela Cruz!"
      android:textColor="#000000"
      android:textSize="24sp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- SUBTITLE -->
  <TextView
      android:id="@+id/textView2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="16dp"
      android:fontFamily="sans-serif-medium"
      android:text="Ready to find your next favorite meal?"
      android:textColor="#070707"
      android:textSize="12sp"
      app:layout_constraintTop_toBottomOf="@id/textView"
      app:layout_constraintStart_toStartOf="@id/textView"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- TOTAL RESERVATIONS -->

  <!-- UPCOMING RESERVATIONS -->

  <!-- FOOD IMAGE -->
  <ImageView
      android:id="@+id/foodImage"
      android:layout_width="31dp"
      android:layout_height="32dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:contentDescription="Food image"
      android:scaleType="fitCenter"
      android:src="@drawable/food"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.08"
      app:layout_constraintStart_toStartOf="parent"
      tools:layout_editor_absoluteY="16dp" />

  <TextView
      android:id="@+id/textView16"
      android:layout_width="80dp"
      android:layout_height="26dp"
      android:fontFamily="sans-serif-black"
      android:text="Reserve"
      android:textColor="#1E4D07"
      android:textColorHighlight="#454D27"
      android:textColorLink="#E28585"
      android:textSize="20sp"
      tools:layout_editor_absoluteX="75dp"
      tools:layout_editor_absoluteY="22dp" />

  <TextView
      android:id="@+id/textView17"
      android:layout_width="80dp"
      android:layout_height="26dp"
      android:fontFamily="sans-serif-black"
      android:text="Reserve"
      android:textColor="#1E4D07"
      android:textColorHighlight="#454D27"
      android:textColorLink="#E28585"
      android:textSize="20sp"
      tools:layout_editor_absoluteX="75dp"
      tools:layout_editor_absoluteY="22dp" />

  <TextView
      android:id="@+id/textView18"
      android:layout_width="80dp"
      android:layout_height="26dp"
      android:fontFamily="sans-serif-black"
      android:text="Bites"
      android:textColor="#4CB31A"
      android:textColorHighlight="#454D27"
      android:textColorLink="#E28585"
      android:textSize="20sp"
      tools:layout_editor_absoluteX="148dp"
      tools:layout_editor_absoluteY="22dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
